{
  "name": "wiredown",
  "displayName": "wiredown: wireframes in markdown",
  "description": "Draw wiredown (UI screens and flows as markdown) in the Markdown preview, with lint and highlighting.",
  "version": "0.1.0",
  "publisher": "PUBLISHER_ID",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/manup-dev/wiredown.git", "directory": "integrations/vscode" },
  "homepage": "https://github.com/manup-dev/wiredown/tree/main/integrations/vscode",
  "bugs": { "url": "https://github.com/manup-dev/wiredown/issues" },
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Visualization", "Programming Languages", "Linters"],
  "keywords": ["wireframe", "mockup", "markdown", "ui", "prototype"],
  "main": "./dist/extension.js",
  "activationEvents": ["onLanguage:markdown", "onLanguage:wiredown"],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": ["./media/preview.css"],
    "languages": [{ "id": "wiredown", "aliases": ["wiredown", "Screens"], "extensions": [".wiredown"], "configuration": "./language-configuration.json" }],
    "grammars": [
      { "language": "wiredown", "scopeName": "source.wiredown", "path": "./syntaxes/wiredown.tmLanguage.json" },
      { "scopeName": "markdown.wiredown.codeblock", "path": "./syntaxes/markdown-injection.json", "injectTo": ["text.html.markdown"], "embeddedLanguages": { "meta.embedded.block.wiredown": "wiredown" } }
    ],
    "commands": [{ "command": "wiredown.openPreview", "title": "wiredown: Open preview" }]
  },
  "scripts": { "vscode:prepublish": "npm run build", "build": "node build.mjs", "test": "node --test test/*.test.mjs", "package": "vsce package" },
  "devDependencies": { "wiredown": "file:../..", "esbuild": "^0.24.0", "@vscode/vsce": "^3.2.1", "markdown-it": "^14.1.0", "vscode-textmate": "^9.1.0", "vscode-oniguruma": "^2.0.1" }
}
