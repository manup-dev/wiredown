{
  "scopeName": "source.wiremark",
  "name": "wiremark",
  "patterns": [
    { "name": "comment.line.double-slash.wiremark", "match": "//.*$" },
    { "name": "keyword.control.header.wiremark", "match": "^\\s*@(device|look|title|flow|requires)\\b" },
    { "match": "^\\s*(screen|variant|define)\\b(?:\\s+([a-z][\\w-]*))?(?:\\s+(of)\\s+([a-z][\\w-]*))?", "captures": { "1": { "name": "keyword.declaration.wiremark" }, "2": { "name": "entity.name.section.wiremark" }, "3": { "name": "keyword.operator.wiremark" }, "4": { "name": "entity.name.section.wiremark" } } },
    { "match": "^\\s*([a-z][a-z0-9]*)\\b", "captures": { "1": { "name": "entity.name.tag.wiremark" } } },
    { "name": "string.quoted.double.wiremark", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.wiremark", "match": "\\\\." }] },
    { "match": "\\b([a-z][a-z0-9-]*)(=)", "captures": { "1": { "name": "entity.other.attribute-name.wiremark" }, "2": { "name": "keyword.operator.assignment.wiremark" } } },
    { "name": "variable.other.id.wiremark", "match": "#[a-z][\\w-]*" },
    { "match": "(->)\\s*([a-z][\\w-]*|back)", "captures": { "1": { "name": "keyword.operator.link.wiremark" }, "2": { "name": "entity.name.section.wiremark" } } },
    { "name": "constant.numeric.wiremark", "match": "\\b\\d+\\b" }
  ]
}
