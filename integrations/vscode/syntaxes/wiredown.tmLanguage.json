{
  "scopeName": "source.wiredown",
  "name": "wiredown",
  "patterns": [
    { "name": "comment.line.double-slash.wiredown", "match": "//.*$" },
    { "name": "keyword.control.header.wiredown", "match": "^\\s*@(device|look|title|flow|requires)\\b" },
    { "match": "^\\s*(screen|variant|define)\\b(?:\\s+([a-z][\\w-]*))?(?:\\s+(of)\\s+([a-z][\\w-]*))?", "captures": { "1": { "name": "keyword.declaration.wiredown" }, "2": { "name": "entity.name.section.wiredown" }, "3": { "name": "keyword.operator.wiredown" }, "4": { "name": "entity.name.section.wiredown" } } },
    { "match": "^\\s*([a-z][a-z0-9]*)\\b", "captures": { "1": { "name": "entity.name.tag.wiredown" } } },
    { "name": "string.quoted.double.wiredown", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.wiredown", "match": "\\\\." }] },
    { "match": "\\b([a-z][a-z0-9-]*)(=)", "captures": { "1": { "name": "entity.other.attribute-name.wiredown" }, "2": { "name": "keyword.operator.assignment.wiredown" } } },
    { "name": "variable.other.id.wiredown", "match": "#[a-z][\\w-]*" },
    { "match": "(->)\\s*([a-z][\\w-]*|back)", "captures": { "1": { "name": "keyword.operator.link.wiredown" }, "2": { "name": "entity.name.section.wiredown" } } },
    { "name": "constant.numeric.wiredown", "match": "\\b\\d+\\b" }
  ]
}
