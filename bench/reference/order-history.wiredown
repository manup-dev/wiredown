@device laptop
screen orders "Order history"
  navbar "Orders"
  stack pad=24 gap=16
    input "Search orders" type=search #search
    list
      item "Order #1042" "Delivered · $48.00" icon=card -> detail
      item "Order #1039" "Shipped · $72.50" icon=card -> detail
      item "Order #1031" "Cancelled · $19.00" icon=card muted
screen detail "Order detail"
  navbar "Order #1042" back -> orders
  stack pad=24 gap=16
    row justify=between
      h2 "Order #1042"
      badge "Delivered" tone=good
    table cols="Item, Qty, Price" rows=2
    row justify=between
      text "Total"
      h3 "$48.00"
    button "Download invoice" icon=card
